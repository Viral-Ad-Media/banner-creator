{
  "name": "banner-creator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "backend:dev": "npm --prefix ../banner-creator-api run dev",
    "backend:typecheck": "npm --prefix ../banner-creator-api run typecheck",
    "backend:build": "npm --prefix ../banner-creator-api run build",
    "backend:start": "npm --prefix ../banner-creator-api run start",
    "check:all": "npm run check && npm --prefix ../banner-creator-api run check",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^3.2.0",
    "react-router-dom": "^7.9.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
